{
  "name": "road-rescue-dashboard",
  "version": "1.4.35",
  "description": "Local dashboard for road-rescue image generation jobs",
  "main": "main.js",
  "author": "Road Rescue Image Factory",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:portable": "electron-builder --win portable --x64",
    "build:installer": "node tools/build-installer.js"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.roadrescue.dashboard",
    "productName": "道路救援图片看板",
    "asar": true,
    "files": [
      "main.js",
      "variables.js",
      "tasks.js",
      "triptych.js",
      "monitor.js",
      "notifications.js",
      "session.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "assets.js",
      "backend.js",
      "installed-runtime.js",
      "update-service.js",
      "branding/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "LocalServiceFactory-${version}-setup.${ext}",
      "icon": "branding/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "branding/logo.ico",
      "uninstallerIcon": "branding/logo.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fang1776358081-arch",
        "repo": "local-service-factory"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
